{
  "name": "parko-prishtina",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "scripts/electron-launcher.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --base=/parko-app/",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "desktop": "node scripts/electron-launcher.mjs",
    "build:desktop": "npm run build && npm run desktop",
    "dev:desktop": "node scripts/electron-launcher.mjs --dev",
    "check": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "@vitejs/plugin-react": "latest",
    "leaflet": "^1.9.4",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.3.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "electron": "^44.0.0",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.11"
  }
}

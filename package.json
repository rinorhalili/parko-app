{
  "name": "parko-prishtina",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "scripts/electron-launcher.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --base=/parko-app/",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "desktop": "node scripts/electron-launcher.mjs",
    "build:desktop": "npm run build && npm run desktop",
    "dev:desktop": "node scripts/electron-launcher.mjs --dev",
    "android:add": "npm run build:android:web && cap add android",
    "android:sync": "npm run build:android:web && cap sync android",
    "android:open": "cap open android",
    "android:check": "node scripts/check-android-release.mjs",
    "android:assets": "node scripts/generate-android-assets.mjs",
    "android:screenshots": "node scripts/capture-play-store-screenshots.mjs",
    "android:bundle": "npm run android:check && npm run android:sync && cd android && gradlew.bat bundleRelease",
    "build:android:web": "tsc -b && vite build --mode android",
    "check": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --workers=1",
    "parking:extract:prishtina": "node scripts/extract-prishtina-parking-map.mjs",
    "parking:extract:prishtina:write": "node scripts/extract-prishtina-parking-map.mjs --write",
    "backend:install": "npm install --prefix backend",
    "backend:dev": "npm run dev --prefix backend",
    "backend:build": "npm run build --prefix backend",
    "backend:test": "npm test --prefix backend",
    "backend:prisma:validate": "npm run prisma:validate --prefix backend",
    "backend:prisma:generate": "npm run prisma:generate --prefix backend"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "@supabase/supabase-js": "2.112.4",
    "@vitejs/plugin-react": "latest",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "maplibre-gl": "^6.9.1",
    "react": "latest",
    "react-dom": "latest",
    "socket.io-client": "^4.8.3",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.3",
    "@playwright/test": "^1.55.0",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.4",
    "@types/node": "^26.3.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "electron": "^44.0.0",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.4",
    "vitest": "^4.1.11"
  }
}

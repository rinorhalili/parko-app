NODE_ENV=development
PORT=4000
POSTGRES_DB=parko
POSTGRES_USER=parko
POSTGRES_PASSWORD=replace-with-a-long-local-password
DATABASE_URL="postgresql://user:password@localhost:5432/parko"
REDIS_URL="redis://localhost:6379"
JWT_ACCESS_SECRET=replace-with-a-unique-32-character-minimum-secret
JWT_REFRESH_SECRET=replace-with-a-different-unique-32-character-minimum-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
EXPO_PUSH_ENABLED=false
# PASSWORD_RESET_WEB_URL=https://app.example.com/?token=replace-after-deploy
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
# EMAIL_FROM=Parko <no-reply@your-domain.example>

NODE_ENV=development
PORT=4000
POSTGRES_DB=parko
POSTGRES_USER=parko
POSTGRES_PASSWORD=replace-with-a-long-local-password
DATABASE_URL=postgresql://parko:replace-with-a-long-local-password@127.0.0.1:5433/parko?schema=public
REDIS_URL=redis://127.0.0.1:6379
JWT_ACCESS_SECRET=replace-with-a-unique-32-character-minimum-secret
JWT_REFRESH_SECRET=replace-with-a-different-unique-32-character-minimum-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=info
EXPO_PUSH_ENABLED=false
# VITE_PUSH_PUBLIC_KEY in the web app must be this same public key.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@parko.app
# Cloudflare Turnstile secret key. Required when NODE_ENV=production.
# TURNSTILE_SECRET_KEY=
# Configure one delivery provider before enabling forgot-password in production.
PASSWORD_RESET_WEB_URL=http://localhost:5173/?token=replace-after-deploy
EMAIL_VERIFICATION_WEB_URL=http://localhost:5173/?verify=replace-after-deploy
# PASSWORD_RESET_DELIVERY_URL=https://your-transactional-mail-webhook.example/send
# PASSWORD_RESET_DELIVERY_TOKEN=replace-with-a-webhook-token-at-least-16-characters
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
# EMAIL_FROM=Parko <no-reply@your-domain.example>
# Private S3-compatible media storage. Docker Compose supplies MinIO defaults.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=parko-media
S3_ACCESS_KEY_ID=parko-minio
S3_SECRET_ACCESS_KEY=replace-with-a-long-minio-secret
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
# Optional Sentry-compatible error ingestion endpoint.
# SENTRY_DSN=https://public@example.ingest.sentry.io/project
VITE_MAPTILER_KEY=x7CGWalBozCZM4h3CEHU
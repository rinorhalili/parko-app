# Supabase browser client configuration.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional verified feed. Expected JSON:
# {"source":"operator","updatedAt":"2026-01-01T12:00:00Z","parkings":[{"id":"osm-way-123","spaces":8,"capacity":40}]}
PARKO_OCCUPANCY_URL=

# Optional error/event collector endpoint. Personal search and location data are stripped client-side.
PARKO_TELEMETRY_URL=

# Optional Web Push integration for reminders that survive a closed app.
VITE_PUSH_PUBLIC_KEY=
PARKO_PUSH_SUBSCRIPTION_URL=


# Valhalla-compatible host. Defaults to the public OSM.de instance.
PARKO_VALHALLA_URL=https://valhalla1.openstreetmap.de

# Production server port.
PORT=4173
